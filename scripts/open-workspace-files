#!/bin/bash
# 用文件管理器打开指定目录（默认 ~/Workspace）
# 用法: open-workspace-files [目录]
set -euo pipefail

TARGET="${1:-${OPENCODE_WORKSPACE:-/home/chenwei/Workspace}}"
[ -d "$TARGET" ] || TARGET="$HOME"

LOG="$HOME/.local/state/mi-remote-launch.log"
mkdir -p "$(dirname "$LOG")"
printf '%s  launch Files     dir=%s\n' "$(date '+%F %T')" "$TARGET" >>"$LOG"

exec /usr/bin/nautilus "$TARGET"
