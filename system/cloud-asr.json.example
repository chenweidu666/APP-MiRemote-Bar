{
  "provider": "xiaomi-token-plan-cn",
  "protocol": "openai-compatible",
  "base_url": "https://token-plan-cn.xiaomimimo.com/v1",
  "model": "mimo-v2.5-asr",
  "language": "auto",
  "timeout_seconds": 20,
  "api_key": "tp-把密钥填在这里",
  "normalize": {
    "enabled": true,
    "target_rms_dbfs": -16,
    "peak_ceiling_dbfs": -2
  },
  "cleanup": {
    "enabled": false,
    "model": "mimo-v2.6-flash",
    "timeout_seconds": 15,
    "max_completion_tokens": 1024,
    "temperature": 0.2,
    "min_chars": 0
  }
}
